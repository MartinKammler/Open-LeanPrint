<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The dark palette. It only overrides the colours in Theme.xaml - the
        styles stay where they are, and ThemeManager merges this dictionary in
        or takes it out again. Every key here must exist in Theme.xaml, so the
        light theme is simply "this dictionary is not loaded".

        The preview sheet stays white on purpose: it is a picture of paper, and
        a dark sheet would be a preview of something the printer never makes.
    -->
    <SolidColorBrush x:Key="Chrome"     Color="#FF1E1E22"/>
    <SolidColorBrush x:Key="Panel"      Color="#FF2A2A2F"/>
    <SolidColorBrush x:Key="Field"      Color="#FF232327"/>
    <SolidColorBrush x:Key="Line"       Color="#FF3E3E46"/>
    <SolidColorBrush x:Key="Ink"        Color="#FFE8E8EC"/>
    <SolidColorBrush x:Key="InkMuted"   Color="#FF9D9DA7"/>
    <SolidColorBrush x:Key="Accent"     Color="#FF4C8DFF"/>
    <SolidColorBrush x:Key="OnAccent"   Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Tint"       Color="#FF243B63"/>
    <SolidColorBrush x:Key="Error"      Color="#FFFF7A7A"/>
    <SolidColorBrush x:Key="Mat"        Color="#FF141417"/>
    <SolidColorBrush x:Key="MatInk"     Color="#FF8A8A94"/>
    <SolidColorBrush x:Key="Thumb"      Color="#FF55555E"/>

</ResourceDictionary>
