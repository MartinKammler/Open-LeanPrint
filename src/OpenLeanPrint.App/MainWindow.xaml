<Window x:Class="OpenLeanPrint.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OpenLeanPrint.App"
        Title="Open-LeanPrint" Height="800" Width="1220" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Chrome}"
        Foreground="{DynamicResource Ink}"
        Icon="pack://application:,,,/OpenLeanPrint;component/Assets/OpenLeanPrint.ico"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">

    <DockPanel>

        <!-- Toolbar: everything that changes the layout -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,10">
            <WrapPanel>
                <!-- A label and its box are grouped so the toolbar wraps between
                     them, never inside one: in German "Papier" ended one row and
                     its drop-down started the next. -->
                <Button x:Name="AddButton" Content="{l:Loc AddPdfs}" Click="AddJobs_Click"/>
                <Button x:Name="RemoveButton" Content="{l:Loc Remove}" Click="RemoveJob_Click"/>
                <ToggleButton x:Name="CollectToggle" Content="{l:Loc Collect}" Margin="6,0,0,0"
                              Click="Collect_Click"
                              ToolTip="{l:Loc Collect.Tip}"/>
                <Button x:Name="PrinterSetupButton" Content="{l:Loc PrinterSetup.Add}" Click="PrinterSetup_Click"
                        ToolTip="{l:Loc PrinterSetup.Tip}"/>

                <Border Width="1" Background="{DynamicResource Line}" Margin="8,2,14,2"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{l:Loc Layout}" Style="{StaticResource Label}" Margin="0,3,8,3"
                               ToolTip="{l:Loc Layout.Tip}"/>
                    <ToggleButton x:Name="Preset1Up" Content="{l:Loc Preset.1up}" Click="Preset_Click" Tag="1x1"/>
                    <ToggleButton x:Name="Preset2Up" Content="{l:Loc Preset.2up}" Click="Preset_Click" Tag="2x1"
                                  ToolTip="{l:Loc Preset.2up.Tip}"/>
                    <ToggleButton x:Name="Preset4Up" Content="{l:Loc Preset.4up}" Click="Preset_Click" Tag="2x2" IsChecked="True"/>
                    <ToggleButton x:Name="Preset9Up" Content="{l:Loc Preset.9up}" Click="Preset_Click" Tag="3x3"/>
                    <ToggleButton x:Name="PresetBooklet" Content="{l:Loc Preset.Booklet}" Click="Preset_Click" Tag="booklet"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{l:Loc Grid}" Style="{StaticResource Label}"/>
                    <TextBox x:Name="GridBox" Width="62" Text="2x2" TextChanged="Grid_Changed"
                             ToolTip="{l:Loc Grid.Tip}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{l:Loc Paper}" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="PaperBox" Width="92" SelectionChanged="Paper_Changed"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{l:Loc Margin}" Style="{StaticResource Label}"
                               ToolTip="{l:Loc Margin.Tip}"/>
                    <TextBox x:Name="MarginBox" Text="8" TextChanged="Debounced_Changed"
                             ToolTip="{l:Loc Margin.Tip}"/>
                    <TextBlock Text="{l:Loc Unit.Mm}" Style="{StaticResource Label}" Margin="4,3,0,3"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{l:Loc Gutter}" Style="{StaticResource Label}"
                               ToolTip="{l:Loc Gutter.Tip}"/>
                    <TextBox x:Name="GutterBox" Text="2" TextChanged="Debounced_Changed"
                             ToolTip="{l:Loc Gutter.Tip}"/>
                    <TextBlock Text="{l:Loc Unit.Mm}" Style="{StaticResource Label}" Margin="4,3,0,3"/>
                </StackPanel>

                <CheckBox x:Name="BorderToggle" Content="{l:Loc PageBorders}" Click="Border_Changed"
                          ToolTip="{l:Loc PageBorders.Tip}"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{l:Loc Watermark}" Style="{StaticResource Label}"/>
                    <TextBox x:Name="WatermarkBox" Width="120" TextChanged="Debounced_Changed"
                             ToolTip="{l:Loc Watermark.Tip}"/>
                </StackPanel>

                <Border Width="1" Background="{DynamicResource Line}" Margin="14,2,10,2"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{l:Loc Profile}" Style="{StaticResource Label}" Margin="0,0,6,0"/>
                    <ComboBox x:Name="ProfileBox" Width="150" IsEditable="True"
                              SelectionChanged="Profile_Selected"
                              ToolTip="{l:Loc Profile.Tip}"/>
                    <Button x:Name="SaveProfileButton" Content="{l:Loc Save}" Click="SaveProfile_Click" Margin="6,0,0,0"/>
                    <Button x:Name="DeleteProfileButton" Content="✕" Click="DeleteProfile_Click"
                            ToolTip="{l:Loc DeleteProfile.Tip}"/>
            
                </StackPanel></WrapPanel>
        </Border>

        <!-- Action bar: what leaves the app -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,10">
            <DockPanel>
                <Button x:Name="PrintCloseButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                        Content="{l:Loc PrintClose}" Click="PrintAndClose_Click" Margin="6,3,0,3" MinWidth="120"
                        IsDefault="True"
                        ToolTip="{l:Loc PrintClose.Tip}"/>
                <Button x:Name="PrintButton" DockPanel.Dock="Right"
                        Content="{l:Loc Print}" Click="Print_Click" Margin="6,3,0,3" MinWidth="90"
                        ToolTip="{l:Loc Print.Tip}"/>
                <ComboBox x:Name="PrinterBox" DockPanel.Dock="Right" Width="220"/>
                <TextBlock DockPanel.Dock="Right" Text="{l:Loc Printer}" Style="{StaticResource Label}"/>
                <ComboBox x:Name="DuplexBox" DockPanel.Dock="Right" Width="180"
                          ToolTip="{l:Loc Sides.Tip}"/>
                <TextBlock DockPanel.Dock="Right" Text="{l:Loc Sides}" Style="{StaticResource Label}"/>
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="{l:Loc SavePdf}" Click="Save_Click"/>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource InkMuted}" Text="{l:Loc Status.NoJobs}"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Job pool. The quieter of the two greys, so the white job cards
                 have something to stand out from. -->
            <Border Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,12,14,8">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Pool.Title}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="{l:Loc Pool.Hint}"/>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Padding="10,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{l:Loc Pages}" Style="{StaticResource Label}" Margin="0,0,6,0"/>
                                <TextBox x:Name="PagesBox" Width="150" TextChanged="Pages_Changed"
                                         ToolTip="{l:Loc Pages.Tip}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="UpButton" Content="↑" Click="MoveUp_Click" ToolTip="{l:Loc MoveUp.Tip}"/>
                                <Button x:Name="DownButton" Content="↓" Click="MoveDown_Click" ToolTip="{l:Loc MoveDown.Tip}"/>
                                <Button x:Name="ClearButton" Content="{l:Loc Clear}" Click="Clear_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <ListBox x:Name="JobList" BorderThickness="0" Margin="8,0"
                                 Background="Transparent"
                                 SelectionChanged="JobList_SelectionChanged"
                                 PreviewMouseRightButtonDown="JobList_RightButtonDown"
                                 ContextMenuOpening="JobList_ContextMenuOpening"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource JobCard}"/>
                            </ListBox.ItemContainerStyle>

                            <!-- The menu lives on the list, not in the item
                                 style. Handlers on elements inside a
                                 Setter.Value are wired by the XAML compiler
                                 through connection ids and come out crossed -
                                 it hands a MenuItem to a TextBlock handler and
                                 the window will not open at all. Which row was
                                 clicked is settled in code instead. -->
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{l:Loc Menu.RemoveJob}" Click="RemoveJob_Click"/>
                                    <MenuItem Header="{l:Loc Menu.RestoreJob}" Click="RestoreJobPages_Click"/>
                                    <Separator/>
                                    <MenuItem Header="{l:Loc Menu.EmptyPool}" Click="Clear_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource InkMuted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EmptyPoolHint" Margin="18" TextWrapping="Wrap"
                                   Foreground="{DynamicResource InkMuted}" VerticalAlignment="Top"
                                   Text="{l:Loc Pool.Empty}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Preview -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource Mat}">
                    <Grid>
                        <!-- The sheet sits in a scroll viewer so it can be zoomed past the
                             window. Its size is set from code: inside a scroll viewer
                             nothing limits it, so Stretch alone would never fit it. -->
                        <ScrollViewer x:Name="PreviewScroller" Focusable="False"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      SizeChanged="PreviewScroller_SizeChanged"
                                      PreviewMouseWheel="PreviewScroller_MouseWheel"
                                      PreviewMouseDown="PreviewScroller_MouseDown"
                                      PreviewMouseMove="PreviewScroller_MouseMove"
                                      PreviewMouseUp="PreviewScroller_MouseUp">
                            <Border x:Name="SheetShadow" Background="White" Margin="28"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                                </Border.Effect>
                                <Image x:Name="PreviewImage" Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       MouseRightButtonUp="Preview_RightClick"/>
                            </Border>
                        </ScrollViewer>

                        <TextBlock x:Name="PreviewHint" Foreground="{DynamicResource MatInk}" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="{l:Loc Preview.Hint}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,10,0,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="PrevSheet" Content="◀" Click="PrevSheet_Click"/>
                        <TextBlock x:Name="SheetLabel" Text="—" MinWidth="140" TextAlignment="Center"/>
                        <Button x:Name="NextSheet" Content="▶" Click="NextSheet_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="PreviewTip" HorizontalAlignment="Center" Margin="0,6,0,0"
                               FontSize="11" Foreground="{DynamicResource InkMuted}"
                               Text="{l:Loc Preview.Tip}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
